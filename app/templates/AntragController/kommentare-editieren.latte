{import ../partials/components.latte}
{var $navId = antraege}

{block title}Kommentare editieren – {$antrag->getName()}{/block}
{block page-label}<i class="ti ti-message" aria-hidden="true"></i> Antrag Nr. {$antrag->getId()}{/block}
{block page-header}
    <div class="action-links">
        <a href="/antraege/{$antrag->getID()}/"><i class="ti ti-arrow-left" aria-hidden="true"></i> zurück zur Detailseite</a>
    </div>
{/block}

{block content}

<section class="panel" aria-label="Kommentare editieren">
    <form method="post">
        {=csrfTokenTag()}
        {include form-group, name: kommentare, label: 'Kommentare', type: textarea, value: $antrag->getKommentare()}

        <div class="form-actions">
            <a class="button ghost" href="/antraege/{$antrag->getID()}/">abbrechen</a>
            <button type="submit">Speichern</button>
        </div>
    </form>
</section>
{/block}
