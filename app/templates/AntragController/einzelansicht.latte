{import ../partials/components.latte}
{var $navId = antraege}

{block title}{$antrag->getName()}{/block}
{block page-label}<i class="ti ti-file" aria-hidden="true"></i> Antrag Nr. {$antrag->getId()}{/block}
{block page-header}
    <div class="meta">
        <span><strong>Antragsdatum:</strong> {$antrag->getDatumAntrag()}</span>
        <span><strong>Status:</strong> {$antrag->getStatusReadable()}</span>
    </div>
    <div class="action-links">
        <a href="/antraege/{$antrag->getId()}/aufnehmen"><i class="ti ti-check" aria-hidden="true"></i> Aufnehmen</a>
        <a href="/antraege/{$antrag->getId()}/nachfragen"><i class="ti ti-help" aria-hidden="true"></i> Nachfragen</a>
        <a href="/antraege/{$antrag->getId()}/ablehnen"><i class="ti ti-x" aria-hidden="true"></i> Ablehnen</a>
    </div>
{/block}

{block content}

{include info-box, text: "Immer nur einen der Punkte auf einmal verändern, also immer den entsprechenden Speichern-Knopf des jeweiligen Abschnitts betätigen!"}

{if $meldung}
    {include info-box, type: info, id: 'meldung-info', text: $meldung}
{/if}

<section class="panel" aria-labelledby="status-heading">
    <h2 id="status-heading"><i class="label-icon ti ti-adjustments" aria-hidden="true"></i>Status des Antrags</h2>

    <p><strong>Hinweis:</strong> Der Status und das entsprechende Datum werden bei Aktionen (siehe Aktionen oben und die Beschreibungen
    auf den Seiten dort) automatisch gesetzt. Ansonsten gibt es keine automatischen Änderungen am Status.</p>

    <form method="post">
        {=csrfTokenTag()}
        <input type="hidden" name="formular" value="grunddaten" />

        {include form-group, name: status, label: 'Status', type: select, value: $antrag->getStatus(), options: $statuscodes}
        <p class="meta-note">zuletzt geändert am {$antrag->getDatumStatusaenderung()} von {$antrag->getStatusaenderungUsername()}</p>

        {include form-group, name: datum_nachfrage, label: 'Nachfragedatum', value: $antrag->getDatumNachfrage()}
        {include form-group, name: datum_antwort, label: 'Antwortdatum', value: $antrag->getDatumAntwort()}
        {include form-group, name: datum_entscheidung, label: 'Entscheidungsdatum', value: $antrag->getDatumEntscheidung()}
        {include form-group, name: bemerkung, label: 'Bemerkung', type: textarea, value: $antrag->getBemerkung()}

        <div class="form-actions">
            <button type="submit" name="sub" value="Speichern">Speichern</button>
        </div>
    </form>
</section>

<section class="panel" aria-labelledby="voten-heading">
    <h2 id="voten-heading"><i class="label-icon ti ti-thumb-up" aria-hidden="true"></i>Voten</h2>
    <p class="meta-note">(chronologisch sortiert, neueste zuerst)</p>

    <div class="table-wrapper"><table>
        <tr><th>Wer</th><th>Votum</th><th>Datum</th><th>Bemerkung</th><th>Nachfrage</th></tr>
        <tr n:foreach="$antrag->getVotes() as $i">
            <td>{$i->getRealName()}</td>
            <td>{$i->getValueReadable()}</td>
            <td>{$i->getTime()|format:"d.m.Y"}</td>
            <td>{nl2br(htmlspecialchars($i->getBemerkung()))|noescape}</td>
            <td>{nl2br(htmlspecialchars($i->getNachfrage()))|noescape}</td>
        </tr>
    </table></div>

    <form method="post">
        {=csrfTokenTag()}
        <input type="hidden" name="formular" value="votes"/>

        {include form-group, name: votum, label: 'Neues Votum von ' . currentUser()->getRealName(), type: select, value: 3, options: [0 => 'Nein', 1 => 'Ja', 2 => 'Nachfragen', 3 => 'Enthaltung']}
        {include form-group, name: bemerkung, id: 'input-vote-bemerkung', label: 'Bemerkung', type: textarea, value: $bemerkung}
        {include form-group, name: nachfrage, id: 'input-vote-nachfrage', label: 'Nachfrage', type: textarea, value: $nachfrage}

        <div class="form-actions">
            <button type="submit">Votum hinzufügen</button>
        </div>
        <p class="small-note">(du wirst wieder auf die Übersichtsseite weitergeleitet)</p>
    </form>
</section>

<section class="panel" aria-labelledby="kommentare-heading">
    <h2 id="kommentare-heading"><i class="label-icon ti ti-message" aria-hidden="true"></i>Kommentare</h2>
    <pre>{$antrag->getKommentare()}</pre>

    <form action="/antraege/{$antrag->getId()}/kommentare" method="post">
        {=csrfTokenTag()}
        {include form-group, name: kommentar, label: 'Kommentar hinzufügen', type: textarea}
        <div class="form-actions">
            <a class="button ghost" href="/antraege/{$antrag->getId()}/kommentare">Kommentare editieren</a>
            <button type="submit">Kommentar hinzufügen</button>
        </div>
    </form>
</section>

<section class="panel" aria-labelledby="mails-heading">
    <h2 id="mails-heading"><i class="label-icon ti ti-mail" aria-hidden="true"></i>Versandte Mails</h2>
    <ul n:if=$mails class="feature-list" n:inner-foreach="$mails as $mail">
        <li>Von {$mail[userName]} am {$mail[time]|format:d.m.Y} zwecks {$mail[grund]}; <a href="/mails/{$antrag->getId()}/{$mail[time]->getTimestamp()}">zum Mailtext</a></li>
    </ul>
    <p n:else class="small-note">keine</p>
</section>
<br>

<form method="post">
    {=csrfTokenTag()}
    <input type="hidden" name="formular" value="daten" />

    {include 'daten.latte'}

    <div class="form-actions">
        <button type="submit">Daten speichern</button>
    </div>
</form>
{/block}
