{import ../partials/components.latte}
{var $navId = antraege}

{block title}{ucfirst($aktion)} – {$antrag->getName()}{/block}
{block page-label}<i class="ti ti-mail" aria-hidden="true"></i> Antrag Nr. {$antrag->getId()}{/block}
{block page-header}
    <div class="action-links">
        <a href="/antraege/{$antrag->getID()}/"><i class="ti ti-arrow-left" aria-hidden="true"></i> zurück zum Antrag</a>
    </div>
{/block}

{block content}

{if $meldung_speichern}
    {include info-box, type: info, id: 'meldung-speichern-info', text: $meldung_speichern}
{/if}
{if $meldungen_laden}
    {include info-box, type: info, id: 'meldungen-laden-info', text: $meldungen_laden}
{/if}

<section class="panel" aria-labelledby="email-heading">
    <p>Bei Bestätigung wird:</p>
    <ul class="feature-list">
        {if $aktion == 'aufnehmen'}
            <li>Eine Aufnahme-E-Mail mit einem Zugangscode versandt (siehe unten).</li>
            <li>Der Antrags-Status auf "Aufgenommen" und das Entscheidungsdatum auf heute gesetzt.</li>
        {elseif $aktion == 'ablehnen'}
            <li>Eine Ablehn-Mail versandt (siehe unten).</li>
            <li>Der Antrags-Status auf "Abgelehnt" gesetzt und das Entscheidungsdatum auf heute gesetzt
                (und damit implizit der Antrag ins Archiv verschoben).
            </li>
        {else}
            <li>Eine Nachfrage-E-Mail versandt (siehe unten).</li>
            <li>Der Antrags-Status auf "Auf Antwort warten" und das Nachfragedatum auf heute gesetzt.</li>
        {/if}
    </ul>

    <h2 id="email-heading"><i class="label-icon ti ti-mail" aria-hidden="true"></i>E-Mail</h2>

    <form method="post">
        {=csrfTokenTag()}
        <dl>
            <div>
                <dt>Von</dt>
                <dd>{$absende_email_kand}</dd>
            </div>
            <div>
                <dt>An</dt>
                <dd>{$antrag->getEMail()}</dd>
            </div>
        </dl>

        {include form-group, name: betreff, label: 'Betreff', value: $mailSubject}
        {include form-group, name: mailtext, label: 'Inhalt', type: textarea, value: $mailText}

        <div class="form-actions">
            <button type="submit">Bestätigen</button>
        </div>
    </form>
</section>
{/block}
